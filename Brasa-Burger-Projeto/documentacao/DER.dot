digraph G{labelloc=t;fontname="Helvetica";fontsize=12;label="DER Sabor & Cia (notação Pé-de-Galinha). Amarelo: entidade forte | Salmão: entidade fraca | Azul: entidade associativa. Símbolo ao lado do pai: || obrigatório, |o opcional. Lado filho: o< zero ou muitos, |< um ou muitos.";rankdir=LR;splines=true;nodesep=.35;ranksep=1.3;node[shape=plaintext,fontname="Helvetica",fontsize=10];edge[color="#555555"];
